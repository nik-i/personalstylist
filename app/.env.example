# Database — SQLite for local dev, PostgreSQL for production
DATABASE_URL="file:./prisma/dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Email transport (set to smtp:// or use Resend/Nodemailer in production)
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="noreply@frock.app"

# OpenAI — used for clothing extraction via GPT-4o vision
OPENAI_API_KEY=""

# Remove.bg — background removal for extracted garment images (50 free calls/month)
REMOVE_BG_API_KEY=""

# MCP — set to your user ID (from the User table) to authenticate wardrobe MCP tools
MCP_USER_ID=""
